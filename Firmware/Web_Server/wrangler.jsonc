// Tercio Control on Cloudflare Workers (static assets only, no Worker code),
// served at control.terciolabs.com. Deploy from this folder: npx wrangler deploy
{
  "name": "tercio-control",
  "compatibility_date": "2026-09-30",
  "routes": [{ "pattern": "control.terciolabs.com", "custom_domain": true }],
  "assets": { "directory": "./public" },
  "observability": { "enabled": true }
}
